# ─────────────────────────────────────────────────────────────────────────────
# EvalForge environment configuration
# Copy to `.env` and fill in the values you need. Every variable is optional;
# a provider is only required if you actually run a benchmark against it.
# ─────────────────────────────────────────────────────────────────────────────

# --- Model provider credentials ---------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Ollama runs locally; override if not on the default port.
OLLAMA_BASE_URL=http://localhost:11434

# Optional per-provider base URL overrides (proxies, Azure, self-hosted, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Persistence -------------------------------------------------------------
# Postgres connection string used by Prisma. Matches docker-compose defaults.
DATABASE_URL=postgresql://evalforge:evalforge@localhost:5432/evalforge?schema=public

# Redis is used by BullMQ for the async run queue and the response cache.
# If unset, the engine falls back to in-process execution and a filesystem cache.
REDIS_URL=redis://localhost:6379

# --- Engine defaults ---------------------------------------------------------
EVALFORGE_CONCURRENCY=8
EVALFORGE_MAX_RETRIES=3
EVALFORGE_REQUEST_TIMEOUT_MS=120000
EVALFORGE_CACHE_DIR=.evalforge/cache
EVALFORGE_LOG_LEVEL=info

# --- Code-execution sandbox (coding benchmarks) ------------------------------
# "local" runs generated code in a subprocess with a timeout (dev only).
# "docker" runs each submission in an ephemeral container (recommended).
EVALFORGE_SANDBOX=local
EVALFORGE_SANDBOX_TIMEOUT_MS=10000

# --- API server --------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0

# --- Web dashboard -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
