{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@evalforge/shared": ["packages/shared/src/index.ts"],
      "@evalforge/providers": ["packages/providers/src/index.ts"],
      "@evalforge/datasets": ["packages/datasets/src/index.ts"],
      "@evalforge/scoring": ["packages/scoring/src/index.ts"],
      "@evalforge/evaluators": ["packages/evaluators/src/index.ts"],
      "@evalforge/benchmark-engine": ["packages/benchmark-engine/src/index.ts"],
      "@evalforge/reporting": ["packages/reporting/src/index.ts"],
      "@evalforge/db": ["packages/db/src/index.ts"],
      "@evalforge/benchmarks": ["benchmarks/src/index.ts"]
    }
  }
}
